server {
  listen 80;
  server_name pr.zyzsharehub.cn;

  location /.well-known/acme-challenge/ {
    root /var/www/certbot;
  }

  location / {
    return 301 https://$host$request_uri;
  }
}

server {
  listen 443 ssl http2;
  server_name pr.zyzsharehub.cn;

  ssl_certificate /etc/letsencrypt/live/pr.zyzsharehub.cn/fullchain.pem;
  ssl_certificate_key /etc/letsencrypt/live/pr.zyzsharehub.cn/privkey.pem;
  ssl_protocols TLSv1.2 TLSv1.3;
  ssl_ciphers HIGH:!aNULL:!MD5;

  # 审查页通过 WebSocket 持续接收任务进度，需要显式升级连接。
  location /review-events {
    proxy_pass http://127.0.0.1:35000/review-events;
    proxy_http_version 1.1;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection "upgrade";
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto https;
    proxy_set_header X-Forwarded-Port 443;
    proxy_set_header X-Forwarded-Host $host;
  }

  # 其余前端静态资源和 API 请求统一经宿主机 nginx 反代到本机 web 容器入口。
  location / {
    proxy_pass http://127.0.0.1:35000;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto https;
    proxy_set_header X-Forwarded-Port 443;
    proxy_set_header X-Forwarded-Host $host;
  }
}
