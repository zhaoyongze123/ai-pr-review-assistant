PORT=3001
DATABASE_URL=postgresql://postgres:postgres@localhost:55432/ai_pr_review
REDIS_URL=redis://localhost:56379
# rule-engine 本地进程默认监听 58001，不通过 docker compose 启动。
RULE_ENGINE_URL=http://127.0.0.1:58001
LLM_API_BASE=https://aiapis.help
LLM_API_KEY=
DEFAULT_LLM_PROVIDER=openai-compatible
DEFAULT_LLM_MODEL=gpt-5.4
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=ai-pr-review-assistant
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
# 使用组织级 LangSmith Key 时再填写。
LANGSMITH_WORKSPACE_ID=
# GitHub 接入使用经典 Personal Access Token 或 GitHub App 安装令牌。
# 这一阶段默认只要求 `repo` 读取权限，私有仓库接入时必须保证 token 可访问目标仓库。
GITHUB_TOKEN=
